{
  "name": "projet-specialisation-developpement",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter back dev\" \"pnpm --filter front dev\" --names \"BACK,FRONT\" --prefix-colors \"blue,magenta\"",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker-compose up -d",
    "start": "pnpm db:start && pnpm dev",
    "setup:https": "node scripts/setup-https.js",
    "fix:devcert": "node scripts/fix-devcert.js",
    "postinstall": "pnpm fix:devcert",
    "prisma:studio": "pnpm --filter back prisma studio",
    "prisma:migrate": "pnpm --filter back prisma migrate dev",
    "prisma:seed": "pnpm --filter back seed",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.8.1"
  }
}
