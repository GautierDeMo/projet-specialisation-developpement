################################## GET ROUTES ##################################

### Show all PRODUCTS
GET https://localhost:3000/api/products

### Show one PRODUCT
GET https://localhost:3000/api/products/{{productId}}

################################# POST ROUTES ##################################

### Create one IMAGE
POST https://localhost:3000/api/images/{{productId}} HTTP/1.1
Content-Type: application/json

{
  "imageUrl": "bfaobfiufbeafveaifbeaoin"
}

### Create one PRODUCT
POST https://localhost:3000/api/products HTTP/1.1
Content-Type: application/json

{
  "category": "Jardin",
  "description": "Pour ramasser les feuilles",
  "images": [],
  "name": "Râteau en plastique",
  "price": 13.5
}

### Search PRODUCTS
POST https://localhost:3000/api/products/search
Content-Type: application/json

{
  "category": "Sport"
}

################################# UPDATE ROUTES #################################

### Update one PRODUCT
PUT https://localhost:3000/api/products/{{productId}} HTTP/1.1
Content-Type: application/json

{
  "category": "",
  "description": "Non",
  "images": [],
  "name": "",
  "price": 1
}

################################# DELETE ROUTES ################################

### Remove one PRODUCT
DELETE https://localhost:3000/api/products/{{productId}} HTTP/1.1
