################################## Variables ###################################

@imageUrl=https://images.unsplash.com/photo-1505740420928-5e560c06d30e
@userEmail=gautier@exemple.com
@userPassword=Doxwar-sydcen-7rapmo
@userId={{login.response.body.user.id}}

################################# GET ROUTES ##################################

### Show one PRODUCT
GET https://localhost:3000/api/products/{{createOneProduct.response.body.product.id}}

################################# POST ROUTES ##################################

### Create one IMAGE
POST https://localhost:3000/api/images/{{createOneProduct.response.body.product.id}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "imageUrl": "{{imageUrl}}"
}

### Create one PRODUCT
# @name createOneProduct
POST https://localhost:3000/api/products HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "category": "Sport",
  "description": "Pour ramasser les feuilles",
  "image": {
    "url": "{{imageUrl}}"
  },
  "name": "Râteau en chocolat vert",
  "price": 13.5
}

### Login
# @name login
POST https://localhost:3000/api/user/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Register
# @name register
POST https://localhost:3000/api/user/register
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### Search PRODUCTS
# Soit on cherche par nom => on supprime la clé 'category', soit par catégorie, et on supprime la clé 'name"
GET https://localhost:3000/api/products/search/
Content-Type: application/json

{
  "category": "Sport"
}


################################# PATCH ROUTES #################################

### Update one PRODUCT
PUT https://localhost:3000/api/products/{{createOneProduct.response.body.product.id}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.accessToken}}

{
  "category": "graouh",
  "description": "Non",
  "name": "Tartanpion",
  "price": 1
}

################################# DELETE ROUTES ################################

### Remove one PRODUCT
DELETE https://localhost:3000/api/products/{{createOneProduct.response.body.product.id}} HTTP/1.1
Authorization: Bearer {{login.response.body.accessToken}}

### Remove one IMAGE
DELETE https://localhost:3000/api/images/
